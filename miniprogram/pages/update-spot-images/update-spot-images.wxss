/* 手动修改景点图片URL页面样式 */
.container {
  padding: 20px;
  min-height: 100vh;
  background-color: #f5f5f5;
}

.header {
  text-align: center;
  margin-bottom: 30px;
}

.title {
  font-size: 18px;
  font-weight: bold;
  color: #333;
}

.form-group {
  margin-bottom: 20px;
}

.label {
  display: block;
  font-size: 14px;
  color: #666;
  margin-bottom: 8px;
}

.input {
  width: 100%;
  padding: 12px;
  border: 1px solid #ddd;
  border-radius: 6px;
  font-size: 14px;
  background-color: #fff;
}

.textarea {
  width: 100%;
  height: 120px;
  padding: 12px;
  border: 1px solid #ddd;
  border-radius: 6px;
  font-size: 14px;
  background-color: #fff;
  line-height: 1.5;
}

.button-group {
  margin: 30px 0;
}

.btn {
  display: block;
  width: 100%;
  padding: 15px;
  margin-bottom: 15px;
  background-color: #007aff;
  color: white;
  border: none;
  border-radius: 8px;
  font-size: 16px;
  text-align: center;
}

.btn.replace-btn {
  background-color: #ff9500;
}

.btn.add-btn {
  background-color: #34c759;
}

.instructions {
  background-color: #fff;
  padding: 20px;
  border-radius: 8px;
  margin-top: 20px;
}

.instruction-title {
  font-size: 16px;
  font-weight: bold;
  color: #333;
  margin-bottom: 15px;
  display: block;
}

.instruction-list text {
  display: block;
  font-size: 14px;
  color: #666;
  margin-bottom: 8px;
  line-height: 1.6;
}

.warning {
  display: block;
  font-size: 14px;
  color: #ff3b30;
  margin-top: 15px;
  font-weight: bold;
}